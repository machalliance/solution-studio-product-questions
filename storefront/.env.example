# Origin the storefront loads the agent's widget from. The storefront renders
# <Script src="${NEXT_PUBLIC_WIDGET_ORIGIN}/embed.js">, and embed.js derives
# the iframe src from its own URL — so this is the single knob that points
# the storefront at a deployed agent's widget.
#
# Local dev: leave unset (defaults to http://localhost:3000 in app/page.tsx).
# Deployed: set to the widget's Vercel production domain, e.g.
#   https://your-widget.vercel.app
# No trailing slash, no path. NEXT_PUBLIC_ vars are inlined at build time,
# so changes require a redeploy of the storefront.
NEXT_PUBLIC_WIDGET_ORIGIN=

# Shared secret the storefront passes to the agent widget on every request. 
# Must match WIDGET_EMBED_SECRET on the widget side. 
# See widget/docs/production-scaling/embed-security.md for the production-grade pattern (HMAC-signed session tokens).
# Generate with: openssl rand -base64 32
NEXT_PUBLIC_WIDGET_EMBED_SECRET=
