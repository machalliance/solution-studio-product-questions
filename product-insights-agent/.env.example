# AI Gateway (required — single key for all AI providers)
AI_GATEWAY_API_KEY=

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=product-insights-agent
# Tag/label to pin prompt pulls to (e.g. "production" or a commit hash).
# Omit for dev — defaults to "latest" so playground edits show up immediately.
# LANGSMITH_PROMPT_TAG=production
# In-process prompt cache TTL in ms. Default 60000 (stale-while-revalidate).
# Set to 0 to disable caching. Set to a larger value (e.g. 300000) for quieter
# deployments where you'd rather amortize hub calls.
# PROMPT_CACHE_TTL_MS=60000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/product-insights

# Embed security
# Shared secret that must match NEXT_PUBLIC_WIDGET_EMBED_SECRET on the
# storefront. Required in production (routes fail closed with 503 if unset).
# Optional in development — unset means the API skips auth.
# Generate with: openssl rand -base64 32
WIDGET_EMBED_SECRET=

# Comma-separated list of origins allowed to call the widget API.
# Example: https://product-insights-storefront.vercel.app
# Empty in production → no cross-origin access (ACAO header omitted).
# Empty in development → falls back to * with a one-time warning.
WIDGET_ALLOWED_ORIGINS=
