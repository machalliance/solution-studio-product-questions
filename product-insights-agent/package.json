{
  "name": "product-insights-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "pnpm build:widget && next build",
    "build:widget": "esbuild src/widget-vanilla/index.ts --bundle --minify --outfile=public/widget/widget.js --platform=browser --target=es2018",
    "dev:widget": "esbuild src/widget-vanilla/index.ts --bundle --outfile=public/widget/widget.js --platform=browser --target=es2018 --watch",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "pipeline:ingest": "tsx --env-file=.env.local tooling/pipeline/ingest.ts",
    "pipeline:clean": "rm -rf data/markdown/* && docker compose exec -T mongodb mongosh product-insights --quiet --eval 'db.chunks.drop(); db.seed_questions.drop();'",
    "seed:regenerate": "tsx --env-file=.env.local tooling/scripts/regenerate-seed-questions.ts",
    "eval:clean:sets": "rm -rf data/eval-sets/*",
    "eval:clean:reports": "rm -rf data/eval-reports/*",
    "eval:ingestion": "tsx --env-file=.env.local tooling/evals/ingestion.ts",
    "eval:sweep": "tsx --env-file=.env.local tooling/scripts/eval-sweep.ts",
    "eval:quality": "tsx --env-file=.env.local tooling/evals/quality.ts",
    "eval:performance": "tsx --env-file=.env.local tooling/evals/performance.ts",
    "eval:via-claude": "tsx --env-file=.env.local tooling/scripts/run-eval-via-claude.ts",
    "eval:history": "tsx --env-file=.env.local tooling/scripts/eval-history.ts",
    "prompts:push": "tsx --env-file=.env.local tooling/scripts/push-prompts.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.69",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/react": "^3.0.163",
    "ai": "^6.0.160",
    "js-tiktoken": "^1.0.21",
    "langsmith": "^0.5.19",
    "mongodb": "^7.1.1",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "streamdown": "^2.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@langchain/core": "^1.1.40",
    "esbuild": "^0.24.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
